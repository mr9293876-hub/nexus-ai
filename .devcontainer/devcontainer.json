{
  "name": "Nexus AI - Hub Universal",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "Hub API", "onAutoForward": "notify" },
    "5173": { "label": "Hub painel", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "python -m pip install -r hub-universal/backend/requirements.txt && cd hub-universal/frontend && npm install",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint"]
    }
  }
}
